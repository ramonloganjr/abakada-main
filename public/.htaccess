# =============================================================================
# Abakada — Apache / cPanel Production Configuration
# =============================================================================

# ── Engine & Options ──────────────────────────────────────────────────────────
Options -Indexes -MultiViews
DirectoryIndex index.html

# ── HTTPS Redirect ────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force non-www (change to www if preferred)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ── i18n: 301 redirects from legacy ?lang=xx to /xx/ subpaths ───────────────
  RewriteCond %{QUERY_STRING} (?:^|&)lang=tl(?:&|$)
  RewriteRule ^(.*)$ /tl/$1? [L,R=301]

  RewriteCond %{QUERY_STRING} (?:^|&)lang=ilo(?:&|$)
  RewriteRule ^(.*)$ /ilo/$1? [L,R=301]

  RewriteCond %{QUERY_STRING} (?:^|&)lang=bis(?:&|$)
  RewriteRule ^(.*)$ /bis/$1? [L,R=301]

  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$)
  RewriteRule ^(.*)$ /$1? [L,R=301]

  # ── Never rewrite real static assets (defensive — even if -f check fails) ───
  RewriteRule ^assets/  -  [L]
  RewriteRule ^favicon  -  [L]
  RewriteRule \.(?:pdf|zip|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mp3|wav|json|xml|txt|webmanifest|map)$ - [L]

  # ── SPA Fallback — serve index.html for all non-file, non-directory routes ──
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/sw\.js$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  RewriteCond %{REQUEST_URI} !^/site\.webmanifest$
  RewriteCond %{REQUEST_URI} !^/offline\.html$
  RewriteRule ^ /index.html [L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS — force HTTPS for 2 years
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Block clickjacking
  Header always set X-Frame-Options "DENY"

  # Legacy XSS filter
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), interest-cohort=()"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Cross-Origin policies
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Remove server fingerprinting headers
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# ── MIME Types ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript          .js .mjs
  AddType text/css                        .css
  AddType image/svg+xml                   .svg
  AddType image/webp                      .webp
  AddType image/avif                      .avif
  AddType font/woff2                      .woff2
  AddType font/woff                       .woff
  AddType application/manifest+json       .webmanifest
  AddType application/json                .json
  AddType text/xml                        .xml
  AddType application/pdf                 .pdf
  AddType application/zip                 .zip
</IfModule>

# ── PDF / downloadable docs ───────────────────────────────────────────────────
# Force correct Content-Type, prevent compression, and trigger a true download
# (instead of in-browser preview) on every browser including mobile Safari,
# which ignores the HTML `download` attribute and only respects the header.
<FilesMatch "\.pdf$">
  <IfModule mod_headers.c>
    Header set Content-Type "application/pdf"
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
    # Allow the asset to be fetched as a blob from the same origin
    Header set Cross-Origin-Resource-Policy "same-origin"
    # Short cache so deck updates propagate quickly
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </IfModule>
  <IfModule mod_deflate.c>
    SetEnv no-gzip 1
    SetEnvIfNoCase Request_URI \.pdf$ no-gzip dont-vary
  </IfModule>
  <IfModule mod_filter.c>
    RemoveOutputFilter pdf
  </IfModule>
</FilesMatch>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml text/xml text/plain text/markdown font/woff2 font/woff
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml text/xml text/plain text/markdown
</IfModule>

# ── Cache Control ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — always revalidate
  ExpiresByType text/html                 "access plus 0 seconds"

  # Hashed JS/CSS assets — 1 year immutable
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"

  # Images — 1 month
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Data files — 1 hour with revalidation
  ExpiresByType application/json          "access plus 1 hour"

  # Manifest & SW — no cache
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# Service worker — never cache
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>

# ── Block Sensitive Files ─────────────────────────────────────────────────────
<FilesMatch "\.(env|log|sh|sql|bak|config|htpasswd|htaccess)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block dot files (except .well-known for SSL)
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\." - [F]
  RewriteRule "^\.well-known/" - [L]
</IfModule>

# ── ETags ─────────────────────────────────────────────────────────────────────
FileETag None
