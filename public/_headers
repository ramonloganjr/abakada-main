/*
  # Strict Transport Security — force HTTPS for 2 years, include subdomains
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Block clickjacking / framing
  X-Frame-Options: DENY

  # Legacy XSS filter (IE/old Edge)
  X-XSS-Protection: 1; mode=block

  # Referrer — send origin only on cross-origin requests
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions — disable all sensitive browser APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), interest-cohort=()

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  # Cross-Origin Opener Policy — prevents cross-origin window access
  Cross-Origin-Opener-Policy: same-origin

  # Cross-Origin Resource Policy — prevents cross-origin reads of assets
  Cross-Origin-Resource-Policy: same-origin

  # Cache control default — revalidate on each request
  Cache-Control: no-cache

# Static assets — long-lived cache (content-hashed filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# Fonts — long-lived cache
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# Data files — stale-while-revalidate
/assets/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Cross-Origin-Resource-Policy: same-origin

# Downloadable docs (PDF, etc.) — force correct MIME + attachment behavior.
# Mobile Safari ignores the HTML `download` attribute, so the header is the
# only reliable way to make the file download instead of inline-preview.
/assets/doc/*
  Content-Type: application/pdf
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600, must-revalidate
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

# Service worker — never cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# Sitemap
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# Robots
/robots.txt
  Cache-Control: public, max-age=86400
