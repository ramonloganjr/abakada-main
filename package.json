{
  "name": "abakada-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "headers": "node scripts/security-headers.mjs",
    "prebuild": "node scripts/refresh-sitemap.js && node scripts/build-search-index.mjs && node scripts/security-headers.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender-shells.js && node scripts/verify-csp.mjs && node scripts/version-sw.mjs",
    "preview": "vite preview",
    "package:cpanel": "npm run build && node scripts/package-cpanel.mjs",
    "sitemap": "node scripts/refresh-sitemap.js",
    "prerender": "node scripts/prerender-shells.js",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^5.7.3",
    "vite": "^8.1.0"
  }
}
